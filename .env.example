# OpenAI Compatible Endpoint & LLM Config
OPENAI_API_BASE=
OPENAI_API_KEY=your_api_key_here
LLM_MODEL=
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
EMBEDDING_DIM=1024

# Database
DATABASE_URL=
# Local Cross-Encoder Reranker Model
RERANKER_MODEL_PATH=models/reranking
RERANKER_TYPE=cross-encoder
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1

# Optional Remote Reranker Endpoint (e.g. TEI, Jina, or custom server)
# RERANKER_ENDPOINT=http://127.0.0.1:8000/api/rerank

# Corpus Paths
PDFS_DIR=pdfs
MANIFEST_PATH=dataset/manifest.json
QA_GROUND_TRUTH_PATH=dataset/qa_ground_truth.json
